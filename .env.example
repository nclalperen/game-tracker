# Environment defaults for Game Tracker
# Register at rawg.io for a free personal key (20k requests/month).
# Do not commit .env.local
VITE_RAWG_KEY=

# Steam Web API (desktop only)
STEAM_WEB_API_KEY=
STEAM_REGION_CC=us     # 2-letter country code for prices/news language
STEAM_LANG=en          # store language code


# Ally AI sidecar (desktop CLI)
ALLY_MODE=cli
ALLY_BIN=                   # leave empty to use bundled path
ALLY_DATA_DIR=              # optional; default %APPDATA%/GameTracker/ally-data
ALLY_PROFILE=default

# Local LLM (llama.cpp) models (desktop-only)
# Override automatic discovery if your filenames differ or models live elsewhere.
LLM_CHAT_MODEL_PATH=apps/desktop/src-tauri/models/Llama-3.2-1B-Instruct-Q4_K_M.gguf
LLM_EMBED_MODEL_PATH=apps/desktop/src-tauri/models/bge-base-en-v1.5.Q4_K_M.gguf
LLM_BIN_CHAT=            # optional override; defaults to bundled resources/bin/llama/main(.exe)
LLM_BIN_EMBED=           # optional override; defaults to bundled resources/bin/llama/embedding(.exe)
LLAMA_RELEASE_TAG=       # optional (default b3538)
LLAMA_REPO=              # optional (default ggml-org/llama.cpp)
LLAMA_SIDECAR_URL=       # optional absolute URL override for llama.cpp binaries

# Real values go in .env.local (not committed).
