{
  "$schema": "https://schemas.tauri.app/config/2",
  "productName": "Game Tracker",
  "version": "0.1.0",
  "identifier": "com.example.gametracker",
  "build": {
    "beforeDevCommand": "pnpm --filter @tracker/web dev -- --port 5173",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @tracker/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Game Tracker", "width": 1280, "height": 800, "resizable": true }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["msi"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "resources": ["bin/ally/**/*", "bin/llama/**/*", "models/**/*"]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://updates.example.com/game-tracker/{{target}}/{{current_version}}"
      ],
      "pubkey": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEt5npJNmPR9U1FVLtZL1NVr7DiIP9N6byjHgNsx3Rp3XIan+FJxuxMxDPZWS9Vyuk3F7S3w7Dnk3a1JpN96CBQ=="
    }
  }
}
